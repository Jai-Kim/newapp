# Storyloom — environment template. Copy to .env (gitignored) and fill in.
# ALL provider keys are server-side only (Supabase Edge Functions). Never ship
# these in the client bundle.

# ---------------------------------------------------------------------------
# CLIENT (Expo app). Only EXPO_PUBLIC_* vars reach the app bundle — so ONLY
# client-safe values may carry this prefix. These are validated by env.ts.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=https://dummyjson.com/
EXPO_PUBLIC_VAR_NUMBER=10
EXPO_PUBLIC_VAR_BOOL=true

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=   # client-safe: RLS is what protects the data

# ---------------------------------------------------------------------------
# SERVER — Supabase Edge Function secrets. Never prefixed with EXPO_PUBLIC_,
# and preferably never written to a local file at all.
#
# Set them in: Dashboard → Project Settings → Edge Functions → Secrets
# (CLI alternative: `supabase secrets set NAME=value`. Avoid
#  `--env-file .env`, which requires the secrets to exist on disk.)
# ---------------------------------------------------------------------------

# Supabase — AUTOMATICALLY INJECTED. Do NOT set these; Supabase provides
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to every Edge Function at runtime.
# Listed here only to document what the functions read.
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY

# Abuse & cost protection on generate-chapter / enqueue-chapter (issue #6).
# Defaults (in supabase/functions/_shared/quota.ts) are conservative
# placeholders pending real usage data — override once Jai has a number.
# CHAPTER_MONTHLY_ALLOWANCE mirrors VOLUME_SIZE (src/features/reader/volumes.ts,
# currently 10) and the client-side allowance on the gated paywall branch —
# there is no module shared between the Expo app and these Deno functions, so
# keep this in sync by hand until the paywall branch merges.
GENERATION_RATE_LIMIT_MAX=        # calls a single user may start per window (default 3)
GENERATION_RATE_LIMIT_WINDOW_MS=  # window length in ms (default 60000)
CHAPTER_MONTHLY_ALLOWANCE=        # chapters a single child may generate per UTC month (default 10)

# Story generation
ANTHROPIC_API_KEY=

# Illustration — pick ONE path for the Spike A winner
IMAGE_PROVIDER=               # gemini | replicate  (which path health-check pings)
GEMINI_API_KEY=               # Google (Nano Banana) path
REPLICATE_API_TOKEN=          # Flux / InstantID path

# Embeddings (for chapter retrieval). Match the vector(N) dim in schema.sql.
EMBEDDINGS_PROVIDER=          # e.g. openai | voyage | gemini
EMBEDDINGS_API_KEY=
