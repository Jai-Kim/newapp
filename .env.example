# Storyloom — environment template. Copy to .env (gitignored) and fill in.
# ALL provider keys are server-side only (Supabase Edge Functions). Never ship
# these in the client bundle.

# ---------------------------------------------------------------------------
# CLIENT (Expo app). Only EXPO_PUBLIC_* vars reach the app bundle — so ONLY
# client-safe values may carry this prefix. These are validated by env.ts.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=https://dummyjson.com/
EXPO_PUBLIC_VAR_NUMBER=10
EXPO_PUBLIC_VAR_BOOL=true

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=   # client-safe: RLS is what protects the data

# ---------------------------------------------------------------------------
# SERVER — Supabase Edge Function secrets. Never prefixed with EXPO_PUBLIC_,
# and preferably never written to a local file at all.
#
# Set them in: Dashboard → Project Settings → Edge Functions → Secrets
# (CLI alternative: `supabase secrets set NAME=value`. Avoid
#  `--env-file .env`, which requires the secrets to exist on disk.)
# ---------------------------------------------------------------------------

# Supabase — AUTOMATICALLY INJECTED. Do NOT set these; Supabase provides
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to every Edge Function at runtime.
# Listed here only to document what the functions read.
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY

# Story generation
ANTHROPIC_API_KEY=

# Illustration — pick ONE path for the Spike A winner
IMAGE_PROVIDER=               # gemini | replicate  (which path health-check pings)
GEMINI_API_KEY=               # Google (Nano Banana) path
REPLICATE_API_TOKEN=          # Flux / InstantID path

# Embeddings (for chapter retrieval). Match the vector(N) dim in schema.sql.
EMBEDDINGS_PROVIDER=          # e.g. openai | voyage | gemini
EMBEDDINGS_API_KEY=

# ---------------------------------------------------------------------------
# ENVIRONMENT GUARD (issue #19) — optional, until a second (staging) Supabase
# project exists. See docs/runbook-environments.md. Appended here rather than
# folded into the CLIENT block above so this stays a clean merge alongside
# other in-flight branches editing that block.
# ---------------------------------------------------------------------------

# The PRODUCTION Supabase project's ref — the subdomain in its URL, e.g.
# "abcdefgh" from https://abcdefgh.supabase.co. Once set, env.ts refuses to
# start whenever EXPO_PUBLIC_SUPABASE_URL points at this ref while
# EXPO_PUBLIC_APP_ENV is not "production". Leave unset until then: this is a
# no-op with nothing yet to compare against.
EXPO_PUBLIC_PROD_SUPABASE_PROJECT_REF=

# ---------------------------------------------------------------------------
# GENERATION QUOTA (issue #6) — the server-side spend guard on generate-chapter
# / enqueue-chapter. Set in: Dashboard → Project Settings → Edge Functions →
# Secrets (same as the SERVER block above; these are Edge Function env vars,
# not client-bundled). All optional — unset falls back to the defaults noted
# below. Neither number is a settled product decision: the monthly figure
# mirrors VOLUME_SIZE (src/features/reader/volumes.ts) purely so a month's
# quota reads as "about one book"; whether a paying family should get a
# higher cap than a free one is not decided here.
# ---------------------------------------------------------------------------

# Max generate-chapter/enqueue-chapter calls per user within the window below.
# Default: 3
GENERATION_RATE_LIMIT_MAX=

# The rate-limit window, in milliseconds. Default: 60000 (one minute)
GENERATION_RATE_LIMIT_WINDOW_MS=

# Chapters a single child may have generated within the current UTC calendar
# month. Default: 10 (mirrors VOLUME_SIZE, i.e. "about one book a month")
CHAPTER_MONTHLY_ALLOWANCE=
