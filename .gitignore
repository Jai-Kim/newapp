# Node / Expo
node_modules/
.expo/
dist/
web-build/
*.log
npm-debug.*
yarn-error.log
/coverage

# Env & secrets — all provider keys are server-side only (ARCHITECTURE §5)
.env
.env.*
# The *.example templates are the documentation for the real files, so they are
# the one thing here that must be committed. `.env.*` above swallows
# `.env.e2e.example` without this second negation, which quietly kept the file
# the E2E README tells people to copy out of the repo.
!.env.example
!.env.e2e.example

# Native (generated by expo prebuild)
/ios
/android
*.keystore
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# EAS
.easignore

# Supabase CLI local state (project ref, service versions) — written by `link`
supabase/.temp/

# OS / editor
.DS_Store
.idea/
.vscode/

